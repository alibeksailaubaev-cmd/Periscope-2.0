# Скопируйте этот файл в .env и вставьте свой ключ, чтобы включить
# генерацию через платный OpenAI (сценарий + голос + картинки) вместо
# бесплатных API. Без этого файла всё продолжит работать бесплатно.
OPENAI_API_KEY=sk-...

# Необязательно — модели по умолчанию уже разумные:
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_TTS_MODEL=tts-1
# OPENAI_TTS_VOICE=alloy
# OPENAI_IMAGE_MODEL=gpt-image-1
# Качество картинок = цена: low / medium / high
# OPENAI_IMAGE_QUALITY=medium

# Анимация через Veo (Google) вместо Sora — ключ с aistudio.google.com
# GEMINI_API_KEY=AIza...
# VEO_MODEL=veo-3.0-fast-generate-001
